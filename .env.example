# Shared secret the caller (Shortcuts, curl, etc.) must send as:
#   Authorization: Bearer <token>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BUTLER_TOKEN=change-me-to-a-long-random-token

# Port the server listens on.
BUTLER_PORT=8787

# Optional: override the bind address. If unset, butler binds to this
# machine's Tailscale IPv4 address (via `tailscale ip -4`), so it's only
# reachable over your tailnet. Set this only if you need something else.
# BUTLER_HOST=100.x.x.x
