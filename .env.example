# Shared secret the caller (Shortcuts, curl, etc.) must send as:
#   Authorization: Bearer <token>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BUTLER_TOKEN=change-me-to-a-long-random-token

# Port the server listens on.
BUTLER_PORT=8787

# Optional: override the bind address. If unset, butler binds to this
# machine's Tailscale IPv4 address (via `tailscale ip -4`), so it's only
# reachable over your tailnet. Set this only if you need something else.
# BUTLER_HOST=100.x.x.x

# Slack notifications. Prefer a bot token (posts via chat.postMessage, can
# target any channel by ID) over an incoming webhook (bound to one channel
# at creation time). Set one or the other.
# Bot token needs the chat:write scope, installed to your workspace. If the
# target channel is public, add chat:write.public too so the bot doesn't
# need to be manually invited.
# BUTLER_SLACK_BOT_TOKEN=xoxb-...
# BUTLER_SLACK_CHANNEL_ID=C0BQ44F6HM5
# BUTLER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Flight price watching (Amadeus Self-Service Flight Offers Search API).
# Sign up free at https://developers.amadeus.com, create an app under "My
# Self-Service Workspace" to get a client id/secret. Test environment
# (default base URL below) has a limited free monthly call quota — check
# current limits on your account before scheduling frequent runs.
# BUTLER_FLIGHT_ENABLED=true
# BUTLER_AMADEUS_CLIENT_ID=...
# BUTLER_AMADEUS_CLIENT_SECRET=...
# BUTLER_AMADEUS_API_BASE=https://test.api.amadeus.com
#
# Routes to watch live in data/flight-routes.json (gitignored — personal
# itinerary, not a secret, just kept out of git like the rest of data/).
# See flight-routes.example.json for the format. Each entry is one
# one-way leg: {label, origin, destination, date, max_price (optional)}.
# BUTLER_FLIGHT_ROUTES_PATH=data/flight-routes.json
# BUTLER_FLIGHT_ADULTS=1
# BUTLER_FLIGHT_CURRENCY=USD
# BUTLER_FLIGHT_SLACK_CHANNEL_ID=C0BQ44F6HM5
