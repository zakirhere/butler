# Shared secret the caller (Shortcuts, curl, etc.) must send as:
#   Authorization: Bearer <token>
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BUTLER_TOKEN=change-me-to-a-long-random-token

# Port the server listens on.
BUTLER_PORT=8787

# Optional: override the bind address. If unset, butler binds to this
# machine's Tailscale IPv4 address (via `tailscale ip -4`), so it's only
# reachable over your tailnet. Set this only if you need something else.
# BUTLER_HOST=100.x.x.x

# Slack notifications. Prefer a bot token (posts via chat.postMessage, can
# target any channel by ID) over an incoming webhook (bound to one channel
# at creation time). Set one or the other.
# Bot token needs the chat:write scope, installed to your workspace. If the
# target channel is public, add chat:write.public too so the bot doesn't
# need to be manually invited.
# BUTLER_SLACK_BOT_TOKEN=xoxb-...
# BUTLER_SLACK_CHANNEL_ID=C0BQ44F6HM5
# BUTLER_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# Flight price watching (Duffel API). Amadeus's free self-service tier was
# decommissioned (July 2026) and is enterprise-sales-gated now — Duffel is
# the replacement: self-serve signup at https://duffel.com, no sales call.
# IMPORTANT: this needs a *live* key (duffel_live_...), not a test key —
# test mode only returns simulated fares from a fake airline. A live key
# requires a payment method on file with Duffel; cost is trivial for our
# call volume (their search fee is ~$0.005/search past a free allowance).
# BUTLER_FLIGHT_ENABLED=true
# BUTLER_DUFFEL_API_KEY=duffel_live_...
# BUTLER_DUFFEL_API_BASE=https://api.duffel.com
#
# Routes to watch live in data/flight-routes.json (gitignored — personal
# itinerary, not a secret, just kept out of git like the rest of data/).
# See flight-routes.example.json for the format. Each entry is one
# one-way leg: {label, origin, destination, date OR date_start+date_end,
# max_price (optional)}.
# BUTLER_FLIGHT_ROUTES_PATH=data/flight-routes.json
# BUTLER_FLIGHT_ADULTS=1
# BUTLER_FLIGHT_SLACK_CHANNEL_ID=C0BQ44F6HM5

# SmartFind Express substitute-job watcher. Keep auto-accept false until the
# profile and selectors have been tested with a dry run.
# BUTLER_SMARTFIND_ENABLED=false
# BUTLER_SMARTFIND_AUTO_ACCEPT=false
# BUTLER_SMARTFIND_POLL_SECONDS=1800
# BUTLER_SMARTFIND_ACCEPT_RETRY_SECONDS=5
# BUTLER_SMARTFIND_ACCEPT_MAX_RETRIES=12
# BUTLER_SMARTFIND_BROWSER_PROFILE=data/smartfind-profile
# BUTLER_SMARTFIND_SLACK_CHANNEL_ID=
# BUTLER_SMARTFIND_KEYCHAIN_SERVICE=com.zakbot.butler.smartfind
# BUTLER_SMARTFIND_KEYCHAIN_ACCOUNT=856027
